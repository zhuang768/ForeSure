# 複製成 .env 後填入實際值：  cp .env.example .env
# .env 已在 .gitignore 中，不會被 commit。

# --- LLM（多代理人辯論用）---
# 走 Gemini 的 OpenAI 相容端點：只要填 Gemini 金鑰，程式碼不用改。
# 之後拿到 OpenAI 額度，把 OPENAI_BASE_URL 整行刪掉、換 key 與 model 即可切回。
OPENAI_API_KEY=貼上你的_Gemini_API_key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 免費層 gemini-3.6-flash 每天只有 20 次請求（一輪 pipeline 用 4 次）；flash-lite 額度高得多且各模型分開計算
OPENAI_MODEL=gemini-3.5-flash-lite
# 主模型被限流 (429) 時自動改用的備援模型
OPENAI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- 後端 API（可選）---
# 允許的前端來源，逗號分隔。部署到 Cloudflare Pages 時填精確網址，例如：
# ATLAS_ALLOWED_ORIGINS=http://localhost:3000,https://你的專案.pages.dev
# ATLAS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JWT 簽章密鑰；未設定時使用 Demo 預設值
# ATLAS_JWT_SECRET=change-me
